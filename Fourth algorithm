import pandas as pd import numpy as np import matplotlib.pyplot as plt 


def load_data(filepath): 

df = pd.read_csv(filepath) 
 
df['Date'] = pd.to_datetime(df['Date']) 
 
df = df.sort_values('Date') 
 
df = df.rename(columns={'Close/Last': 'Close'}) 
 
return df 
  

def create_features(df): 


df['return'] = np.log(df['Close'] / df['Close'].shift(1)) 
 

df['ma_20'] = df['Close'].rolling(20).mean() 
df['ma_50'] = df['Close'].rolling(50).mean() 
df['trend_200'] = df['Close'].rolling(200).mean() 
 

df['volatility'] = df['return'].rolling(20).std() 
 

delta = df['Close'].diff() 
 
gain = np.where(delta > 0, delta, 0) 
loss = np.where(delta < 0, -delta, 0) 
 
avg_gain = pd.Series(gain).rolling(14).mean() 
avg_loss = pd.Series(loss).rolling(14).mean() 
 
rs = avg_gain / avg_loss 
 
df['RSI'] = 100 - (100 / (1 + rs)) 
 
return df 
  

def generate_signals(df): 

vol_limit = df['volatility'].quantile(0.75) 
 
df['signal'] = np.where( 
 
    (df['ma_20'] > df['ma_50']) & 
    (df['Close'] > df['trend_200']) & 
    (df['volatility'] < vol_limit) & 
    (df['RSI'] < 70), 
 
    1, 
    0 
) 
 
return df 
  

def backtest(df): 


df['position_size'] = 0.01 / df['volatility'] 
 

df['stop_loss'] = -1 * df['volatility'] 
df['take_profit'] = 2 * df['volatility'] 
 

df['strategy_return'] = ( 
    df['signal'].shift(1) 
    * df['return'] 
    * df['position_size'] 
) 
 

df['strategy_return'] = np.clip( 
    df['strategy_return'], 
    df['stop_loss'], 
    df['take_profit'] 
) 

df['cum_strategy'] = df['strategy_return'].cumsum().apply(np.exp) 
df['cum_market'] = df['return'].cumsum().apply(np.exp) 
 
return df 
  

def sharpe_ratio(returns): 

return np.sqrt(252) * returns.mean() / returns.std() 
  

def max_drawdown(cum_returns): 

peak = cum_returns.cummax() 
 
drawdown = (cum_returns - peak) / peak 
 
return drawdown.min() 
  

def monte_carlo_simulation(returns, n_sim=1000): 

mean = returns.mean() 
std = returns.std() 
 
n_days = len(returns) 
 
simulations = [] 
 
for i in range(n_sim): 
 
    random_returns = np.random.normal( 
        mean, 
        std, 
        n_days 
    ) 
 
    path = np.cumprod(1 + random_returns) 
 
    simulations.append(path) 
 
return simulations 
  


def main(): 

filepath = "SPY.csv"   
 
 
print("Loading data...") 
df = load_data(filepath) 
 
 
print("Creating features...") 
df = create_features(df) 
 
 
print("Generating signals...") 
df = generate_signals(df) 
 
 
print("Running backtest...") 
df = backtest(df) 
 
 
print("Calculating performance...") 
 
returns = df['strategy_return'].dropna() 
 
sharpe = sharpe_ratio(returns) 
 
drawdown = max_drawdown(df['cum_strategy']) 
 
 
print("\n=== BACKTEST RESULTS ===") 
print("Sharpe Ratio:", round(sharpe, 3)) 
print("Max Drawdown:", round(drawdown * 100, 2), "%") 
 
 
 
print("\nRunning Monte Carlo Simulation...") 
 
simulations = monte_carlo_simulation(returns) 
 
 
final_values = [sim[-1] for sim in simulations] 
 
 
print("\n=== MONTE CARLO RESULTS ===") 
print("Worst Case:", round(min(final_values), 2)) 
print("Best Case:", round(max(final_values), 2)) 
print("Median:", round(np.median(final_values), 2)) 
print("5% VaR:", round(np.percentile(final_values, 5), 2)) 
 
print("Plotting distribution...") 
plot_markov_distribution(simulations) 
 
 
plt.figure(figsize=(12,6)) 
 
plt.plot(df['Date'], df['cum_strategy'], label="Strategy") 
plt.plot(df['Date'], df['cum_market'], label="Market") 
 
plt.legend() 
plt.title("Backtest Result") 
 
plt.show() 
 
 
plt.figure(figsize=(12,6)) 
 
for sim in simulations: 
    plt.plot(sim, color="gray", alpha=0.1) 
 
plt.title("Monte Carlo Simulation") 
plt.xlabel("Days") 
plt.ylabel("Portfolio Growth") 
 
plt.show() 
  

def plot_markov_distribution(simulations): 

final_values = [sim[-1] for sim in simulations] 
 
plt.figure(figsize=(12,6)) 
 
counts, bins, _ = plt.hist( 
    final_values, 
    bins=40, 
    density=True, 
    alpha=0.6, 
    edgecolor="black" 
) 
 

from scipy.stats import gaussian_kde 
 
kde = gaussian_kde(final_values) 
 
x_vals = np.linspace( 
    min(final_values), 
    max(final_values), 
    500 
) 
 
y_vals = kde(x_vals) 
 
 

plt.plot( 
    x_vals, 
    y_vals, 
    linewidth=2, 
    label="Density Curve" 
) 
 
plt.xlabel("Final Portfolio Value") 
plt.ylabel("Density") 
plt.title("Markov Monte Carlo Distribution") 
 
plt.legend() 
plt.grid(alpha=0.3) 
 
plt.show() 
  

if name == "main": 

main() 
 